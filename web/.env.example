# ─── Core ───────────────────────────────────────────────────────────────
# Dev: SQLite file. Production: PostgreSQL (run `node scripts/use-postgres.mjs` once).
DATABASE_URL="file:./dev.db"
# Signs customer + staff sessions. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=""                    # REQUIRED in production (32+ random chars); blank uses a local-dev secret
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Store details (shown on Contact, footer, receipts) ────────────────
NEXT_PUBLIC_STORE_PHONE="0334 6888696"
NEXT_PUBLIC_STORE_WHATSAPP="923346888696"
NEXT_PUBLIC_STORE_EMAIL="info@pbmobiles.com"
NEXT_PUBLIC_STORE_ADDRESS="PB Mobiles, Shop #30, Ghouri Mobile Mall, Ghouri Town, Islamabad"

# ─── Payments (§3) ──────────────────────────────────────────────────────
# SANDBOX = local test gateway. Switch to JAZZCASH once merchant credentials arrive.
PAYMENT_PROVIDER="SANDBOX"
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""
JAZZCASH_ENV="sandbox"            # sandbox | production

# ─── File storage (Cloudflare R2 / AWS S3). Leave blank to store in /public/uploads ─
STORAGE_BUCKET=""
STORAGE_ENDPOINT=""               # R2: https://<account-id>.r2.cloudflarestorage.com
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_URL=""             # public bucket / CDN URL, e.g. https://media.pbmobiles.pk
BACKUP_BUCKET=""                  # optional separate bucket for nightly backups

# ─── Notifications (optional — each channel turns on when configured) ──
WHATSAPP_TOKEN=""                 # Meta WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_GENERIC=""      # approved template name with one body parameter
SMS_API_URL=""                    # any HTTP SMS gateway accepting {to, message}
SMS_API_KEY=""
RESEND_API_KEY=""                 # transactional email
EMAIL_FROM="PB Mobiles <no-reply@pbmobiles.com>"
STAFF_ALERT_EMAIL=""              # receives new-repair alerts

# ─── 6-photo → 3D, AI pipeline (§14, optional) ─────────────────────────
MESHY_API_KEY=""

# ─── Chat notifications (Web Push, optional) ────────────────────────────
# Generate once with: npx web-push generate-vapid-keys   (keep the private key secret)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@pbmobiles.pk"
