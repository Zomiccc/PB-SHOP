// PB Mobiles & Repairing Lab — database schema
//
// Per the brief's "Developer Priority" note, inventory/barcode, audit logs, employee notes,
// Phone Passport points lots, installments, ID documents, broadcasts, roles and 6-photo 3D generation
// are modelled from day one, not bolted on later. (The old Care Card system was removed by the master brief.)
//
// Dev uses SQLite so the project runs with zero setup. Production should switch the
// provider to "postgresql" (Neon / Supabase / RDS). Enum-like columns are plain strings
// validated in src/lib/constants.ts so the schema works on both providers unchanged.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Staff & auth (§16) ───────────────────────────────

/// 7 individual accounts: 6 ADMIN (employees) + 1 SUPER_ADMIN (owner). No shared logins.
model Staff {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("ADMIN") // ADMIN | SUPER_ADMIN
  active       Boolean  @default(true)
  mustChangePassword Boolean @default(true) // forced reset on first login
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  loginEvents     StaffLoginEvent[]
  auditLogs       AuditLog[]
  notes           Note[]
  stockMovements  StockMovement[]
  ordersHandled   Order[]              @relation("OrderStaff")
  repairsAssigned RepairRequest[]      @relation("RepairAssignee")
  repairChanges   RepairStatusChange[]
  loyaltyTx       LoyaltyTransaction[]
  modelJobs       Model3DJob[]
  installments    InstallmentSale[]
  usedPurchases   UsedPhonePurchase[]
  attachments     Attachment[]
  broadcasts      Broadcast[]
  chatMessages    ChatMessage[]
  pushSubs        PushSubscription[]
}

model StaffLoginEvent {
  id        String   @id @default(cuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id])
  type      String // LOGIN | LOGOUT | LOGIN_FAILED
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([staffId, createdAt])
}

/// Super-admin audit trail: timestamp, user, action, affected record, before/after (§16, §10).
model AuditLog {
  id          String   @id @default(cuid())
  staffId     String?
  staff       Staff?   @relation(fields: [staffId], references: [id])
  action      String // e.g. PRODUCT_PRICE_CHANGED, STOCK_ADJUSTED, SALE_COMPLETED, REWARD_UPDATED, BROADCAST_PUBLISHED
  entityType  String // PRODUCT | VARIANT | ORDER | REPAIR | CUSTOMER | SETTING | LOYALTY | REWARD | INSTALLMENT | BROADCAST | USED_PURCHASE | ATTACHMENT
  entityId    String?
  recordLabel String? // human label: "iPhone 13 / SKU PB-013", "Repair #1042"
  before      String? // JSON snapshot
  after       String? // JSON snapshot
  ip          String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([staffId, createdAt])
  @@index([entityType, entityId])
}

// ─────────────────────────────── Customers & loyalty (§7, PB Phone Passport) ───────────────────────────────

model Customer {
  id            String   @id @default(cuid())
  name          String
  phone         String   @unique
  email         String?  @unique
  passwordHash  String? // null for walk-in / guest customers created at POS
  passportNo    String   @unique // PB Phone Passport number shown to customer
  loyaltyPoints Int      @default(0) // cached balance = sum of unexpired, unspent earning lots
  marketingOptIn Boolean @default(false)
  // Birthday from the Passport form: month + day only — the year is never asked for (Passport brief §2)
  birthMonth    Int? // 1–12
  birthDay      Int? // 1–31
  // Card expiry: an admin/system field. Never printed on the physical card; shown on the digital card
  // only when the owner turns that on (Setting "passportCard") — Passport brief §1.
  cardExpiresAt DateTime?
  // Joined the Passport (online sign-up / staff-issued card / claimed profile). Makes them eligible for the
  // welcome reward, which is credited on their first paid purchase or completed repair (Passport brief §4).
  passportJoinedAt DateTime?
  // Referral (Passport brief §3): who referred this customer, and when the referrer was credited.
  referredById       String?
  referredBy         Customer?  @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals         Customer[] @relation("Referrals")
  referralRewardedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders       Order[]
  repairs      RepairRequest[]
  loyaltyTx    LoyaltyTransaction[]
  notes        Note[]
  installments InstallmentSale[]
}

/// Every points event. Positive events (EARN / PROMO / positive ADJUST) are "lots": each keeps its own
/// expiry date and `remaining` balance, so six-month expiry is exact per earning event (master brief §4).
/// Spending, deductions and expiry consume lots oldest-first (see src/lib/loyalty.ts).
model LoyaltyTransaction {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  type       String // EARN | REDEEM | ADJUST | EXPIRE | PROMO | AWARD (manual award by staff)
  source     String? // REPAIR | NEW_PHONE | USED_PHONE | WELCOME | REFERRAL | MANUAL (earning events)
  points     Int // positive = earned, negative = spent/expired
  remaining  Int? // lots only: points of this event not yet spent or expired
  reason     String?
  orderId    String?
  order      Order?    @relation(fields: [orderId], references: [id])
  repairId   String?
  repair     RepairRequest? @relation(fields: [repairId], references: [id])
  rewardId   String?
  reward     Reward?   @relation(fields: [rewardId], references: [id])
  staffId    String?
  staff      Staff?    @relation(fields: [staffId], references: [id])
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId, createdAt])
  @@index([customerId, expiresAt])
}

/// Phone Passport rewards — created/edited/enabled by the Super Admin; every change audited.
model Reward {
  id              String   @id @default(cuid())
  name            String
  description     String?
  pointsCost      Int
  kind            String   @default("ITEM") // ITEM (e.g. AirPods, a case) | REPAIR_DISCOUNT
  appliesTo       String   @default("ACCESSORY") // ACCESSORY | REPAIR
  discountPercent Int? // REPAIR_DISCOUNT only, e.g. 50
  exclusions      String? // e.g. "Excludes parts"
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  transactions LoyaltyTransaction[]
}

// ─────────────────────────────── Catalogue & inventory (§5, §6, §19) ───────────────────────────────

model Product {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  brand           String
  type            String // PHONE | TABLET | ACCESSORY | PART (phone spare parts)
  condition       String   @default("NEW") // NEW | USED  (accessories are NEW)
  accessoryType   String? // CASE | CHARGER | CABLE | SCREEN_PROTECTOR | POWER_BANK | EARBUDS | OTHER
  partType        String? // spare parts: SCREEN | BATTERY | CHARGING_PORT | CAMERA | BACK_GLASS | SPEAKER | OTHER
  compatibleModel String? // spare parts: e.g. "iPhone 13 / 13 Pro"
  description     String
  specs           String   @default("{}") // JSON key/value spec sheet
  images          String   @default("[]") // JSON array of image URLs
  finishHex       String? // colour used to tint the procedural 3D phone when no GLB exists
  featured        Boolean  @default(false)
  active          Boolean  @default(true) // deactivate instead of hard delete
  loyaltyEligible Boolean  @default(true)

  // 3D (§4, §14)
  model3dUrl      String? // approved GLB/GLTF shown in customer viewer
  model3dKind     String? // GLB | TEXTURED (6-photo textured parametric model)
  model3dTextures String? // JSON {front,back,left,right,top,bottom} for TEXTURED
  sketchfabUid    String? // optional licensed Sketchfab embed

  // SEO (§10 editable metadata)
  metaTitle       String?
  metaDescription String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  variants  Variant[]
  modelJobs Model3DJob[]
  reviews   Review[]

  @@index([type, condition, active])
  @@index([brand])
}

/// Sellable unit. Every variant has a unique SKU and barcode (§6).
/// Used phones are usually one physical device per variant (stock 1) with its own grade/battery data.
model Variant {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id])
  sku               String   @unique // the Item Number printed on labels and typed/scanned at the till
  barcode           String   @unique
  imei              String? // phones / tablets: one physical device per SKU (uniqueness checked in src/lib/inventory.ts)
  partNumber        String? // spare parts: manufacturer part number; accessories: article number
  storage           String?
  ram               String? // tablets / phones where applicable, e.g. "8GB"
  color             String?
  colorHex          String?
  price             Int // PKR, whole rupees
  salePrice         Int?
  costPrice         Int? // purchase price per unit (investment / profit reports)
  stockQty          Int      @default(0)
  lowStockThreshold Int      @default(2)
  allowBackorder    Boolean  @default(false) // zero-stock exception, set only by authorised admin

  // Used-device fields (§2 Used Phones). ONE grade per SKU — enforced in src/lib/grade.ts (master brief §8).
  grade             String? // A+ | A | B | C (used devices only; null for new)
  batteryHealth     Int? // %
  conditionNotes    String?
  warrantyInfo      String?
  returnInfo        String?

  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  movements     StockMovement[]
  orderItems    OrderItem[]
  usedPurchases UsedPhonePurchase[]

  @@index([productId])
  @@index([imei])
}

/// Every stock change: additions, sales, returns, cancellations, manual adjustments (§6, §19).
model StockMovement {
  id        String   @id @default(cuid())
  variantId String
  variant   Variant  @relation(fields: [variantId], references: [id])
  type      String // PURCHASE | RECEIVED | SALE | RETURN | CANCEL | ADJUST
  qtyChange Int
  qtyAfter  Int
  unitPrice Int? // sale price per unit (SALE / RETURN) or purchase price per unit (PURCHASE)
  reference String? // supplier invoice, order number, used-phone purchase ref…
  reason    String? // notes
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id])
  staffId   String? // null only for automated online sales
  staff     Staff?   @relation(fields: [staffId], references: [id])
  createdAt DateTime @default(now())

  @@index([variantId, createdAt])
  @@index([type, createdAt])
}

/// Automatic 6-photo → 3D pipeline (§14). Photos are kept so the model can be regenerated.
model Model3DJob {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  status        String    @default("PROCESSING") // PROCESSING | READY | FAILED | NEEDS_REVIEW | APPROVED
  pipeline      String    @default("TEXTURED") // TEXTURED (parametric, instant) | AI (image-to-3D provider)
  provider      String // TEXTURED | MESHY | TRIPO | SELF_HOSTED
  providerJobId String?
  photoFront    String
  photoBack     String
  photoLeft     String
  photoRight    String
  photoTop      String
  photoBottom   String
  resultUrl     String?
  error         String?
  createdById   String
  createdBy     Staff     @relation(fields: [createdById], references: [id])
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([productId, createdAt])
}

// ─────────────────────────────── Orders & payments (§3) ───────────────────────────────

model Order {
  id               String   @id @default(cuid())
  number           String   @unique // PB-100001
  channel          String // ONLINE | POS
  customerId       String?
  customer         Customer? @relation(fields: [customerId], references: [id])
  customerName     String
  customerPhone    String
  customerEmail    String?
  shippingAddress  String?
  city             String?
  fulfilment       String   @default("DELIVERY") // DELIVERY | PICKUP | IN_STORE
  subtotal         Int
  discount         Int      @default(0)
  shippingFee      Int      @default(0)
  total            Int
  paymentStatus    String   @default("PENDING") // PENDING | PAID | FAILED | REFUNDED | CANCELLED
  fulfilmentStatus String   @default("NEW") // NEW | PROCESSING | READY | SHIPPED | COMPLETED | CANCELLED | RETURNED
  staffId          String? // employee who processed a POS sale
  staff            Staff?   @relation("OrderStaff", fields: [staffId], references: [id])
  stockCommitted   Boolean  @default(false) // true once inventory was decremented
  socialProofLabel String? // privacy-safe label, e.g. "Ali K. from Lahore" (§15)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  items      OrderItem[]
  payments   Payment[]
  notes      Note[]
  movements  StockMovement[]
  loyaltyTx  LoyaltyTransaction[]

  @@index([createdAt])
  @@index([paymentStatus])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])
  name      String
  sku       String
  grade     String? // snapshot of the SKU's single grade at sale time (receipts/invoices)
  unitPrice Int
  unitCost  Int? // purchase price snapshot for profit / margin
  qty       Int
}

/// Gateway transaction. Never stores card/bank credentials — only references and status.
model Payment {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  provider    String // JAZZCASH | EASYPAISA | PAYFAST | SAFEPAY | CASH | SANDBOX
  method      String? // MOBILE_WALLET | DIRECT_DEBIT | CARD | OTC | CASH
  providerRef String? // gateway transaction reference
  amount      Int
  status      String   @default("PENDING") // PENDING | SUCCESS | FAILED
  rawResponse String? // verified gateway payload for reconciliation
  verifiedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([providerRef])
}

// ─────────────────────────────── Repairs (§8) ───────────────────────────────

model RepairRequest {
  id            String    @id @default(cuid())
  ref           String    @unique // PBR-1042
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  name          String
  phone         String
  email         String?
  brand         String
  model         String
  imei          String? // IMEI or serial number, recorded at intake
  category      String // SCREEN | BATTERY | CHARGING | CAMERA | WATER | SOFTWARE | SPEAKER_MIC | OTHER
  description   String
  photos        String    @default("[]") // JSON array of uploaded photo URLs
  preferredAt   DateTime?
  dropOff       String    @default("WALK_IN") // WALK_IN | APPOINTMENT | PICKUP
  status        String    @default("NEW") // NEW | RECEIVED | DIAGNOSING | AWAITING | REPAIRING | READY | COMPLETED | CANCELLED
  quote         Int?
  finalPrice    Int?
  partsCost     Int? // part of the charge that is parts (Passport repair discounts exclude parts)
  rewardDiscount Int? // Phone Passport discount applied to this repair
  assignedToId  String?
  assignedTo    Staff?    @relation("RepairAssignee", fields: [assignedToId], references: [id])
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  statusChanges   RepairStatusChange[]
  notes           Note[]
  loyaltyTx       LoyaltyTransaction[]
  attachments     Attachment[]

  @@index([status, createdAt])
}

model RepairStatusChange {
  id        String        @id @default(cuid())
  repairId  String
  repair    RepairRequest @relation(fields: [repairId], references: [id])
  from      String?
  to        String
  staffId   String?
  staff     Staff?        @relation(fields: [staffId], references: [id])
  createdAt DateTime      @default(now())
}

// ─────────────────────────────── Employee notes (§17) ───────────────────────────────

model Note {
  id         String         @id @default(cuid())
  kind       String // SALE | REPAIR | CUSTOMER
  body       String
  important  Boolean        @default(false)
  // Repair notes may be structured: reported issue, findings, work done, parts used
  meta       String? // JSON
  authorId   String
  author     Staff          @relation(fields: [authorId], references: [id])
  orderId    String?
  order      Order?         @relation(fields: [orderId], references: [id])
  repairId   String?
  repair     RepairRequest? @relation(fields: [repairId], references: [id])
  customerId String?
  customer   Customer?      @relation(fields: [customerId], references: [id])
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

// ─────────────────────────────── Site: contact, chat, settings ───────────────────────────────

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  subject   String?
  message   String
  status    String   @default("NEW") // NEW | REPLIED | CLOSED
  createdAt DateTime @default(now())

  attachments Attachment[]
}

model ChatConversation {
  id        String        @id @default(cuid())
  visitorId String
  name      String?
  phone     String?
  status    String        @default("OPEN") // OPEN | HANDED_OFF | CLOSED
  visitorReadAt DateTime? // last time the customer saw the thread (read receipts)
  staffReadAt   DateTime? // last time staff opened the thread
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
  pushSubs  PushSubscription[]

  @@index([visitorId])
}

/// Chat message: sender, timestamp, delivery/read state, and attachment / voice-note metadata (master brief §13).
model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id])
  from           String // VISITOR | BOT | STAFF
  staffId        String? // which employee sent a STAFF message
  staff          Staff?           @relation(fields: [staffId], references: [id])
  kind           String           @default("TEXT") // TEXT | FILE | VOICE
  body           String
  durationSec    Float? // voice notes
  waveform       String? // voice notes: JSON array of 0–1 peaks for the waveform
  deliveredAt    DateTime? // recipient's device fetched it
  readAt         DateTime? // recipient opened the thread
  createdAt      DateTime         @default(now())

  attachments Attachment[]

  @@index([conversationId, createdAt])
}

/// Browser / phone push subscription (Web Push). Customers subscribe per conversation; staff per account.
model PushSubscription {
  id             String            @id @default(cuid())
  endpoint       String            @unique
  p256dh         String
  auth           String
  audience       String // VISITOR | STAFF
  conversationId String?
  conversation   ChatConversation? @relation(fields: [conversationId], references: [id])
  staffId        String?
  staff          Staff?            @relation(fields: [staffId], references: [id])
  createdAt      DateTime          @default(now())
}

/// Key/value config: social-proof toggle/frequency, loyalty earn rates, expiry, shipping fee, etc.
model Setting {
  key       String   @id
  value     String // JSON
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────── Reviews (master brief §3, §17) ───────────────────────────────

/// Customer reviews. Only APPROVED reviews are shown publicly; staff moderate in Admin → Reviews.
model Review {
  id           String    @id @default(cuid())
  productId    String? // null = review of the shop / repair service
  product      Product?  @relation(fields: [productId], references: [id])
  customerName String
  phone        String? // private — used to mark verified purchases, never displayed
  rating       Int // 1–5
  title        String?
  body         String
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  verified     Boolean   @default(false) // reviewer has a paid order / repair with us
  moderatedBy  String?
  moderatedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([status, createdAt])
  @@index([productId, status])
}

// ─────────────────────────────── Installments (master brief §3, §5) ───────────────────────────────

/// Phones on installments shown in the homepage section. Informational only: no online checkout —
/// customers visit the store with their CNIC. Managed (add / edit / reorder / remove) in Admin → Installments.
model InstallmentListing {
  id               String   @id @default(cuid())
  brand            String? // brand slug for the installment picker, e.g. "infinix", "tecno" (src/lib/brands.ts)
  model            String // e.g. "Samsung Galaxy A55 8/256GB"
  productId        String? // optional link to the catalogue product page
  imageUrl         String?
  regularPrice     Int
  installmentTotal Int // total payable on the plan
  interestPercent  Float    @default(0)
  downPayment      Int
  durationMonths   Int
  planLabel        String? // e.g. "12 monthly payments"
  availability     String   @default("AVAILABLE") // AVAILABLE | LIMITED | OUT_OF_STOCK
  active           Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sales InstallmentSale[]
}

/// A new phone sold on installments in store (staff workflow). CNIC front + back are required.
model InstallmentSale {
  id              String              @id @default(cuid())
  ref             String              @unique // PBI-1001
  listingId       String?
  listing         InstallmentListing? @relation(fields: [listingId], references: [id])
  customerId      String?
  customer        Customer?           @relation(fields: [customerId], references: [id])
  customerName    String
  customerPhone   String
  cnicNumber      String
  address         String?
  phoneModel      String
  imei            String?
  totalPrice      Int
  downPayment     Int
  monthlyPayment  Int
  durationMonths  Int
  status          String              @default("PENDING") // PENDING | APPROVED | ACTIVE | COMPLETED | CANCELLED
  idConsentAt     DateTime? // customer agreed to the ID privacy notice (shown before the CNIC was taken)
  notes           String?
  staffId         String
  staff           Staff               @relation(fields: [staffId], references: [id])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  attachments Attachment[]
}

// ─────────────────────────────── Buying used phones (master brief §6) ───────────────────────────────

/// A person selling their used phone to PB Mobiles. CNIC front + back are required.
model UsedPhonePurchase {
  id            String   @id @default(cuid())
  ref           String   @unique // PBU-1001
  sellerName    String
  sellerPhone   String
  sellerCnic    String
  sellerAddress String?
  brand         String
  model         String
  imei          String
  storage       String?
  color         String?
  grade         String // exactly one grade (src/lib/grade.ts)
  batteryHealth Int?
  agreedPrice   Int
  idConsentAt   DateTime? // seller agreed to the ID privacy notice
  notes         String?
  variantId     String? // SKU created in inventory for resale
  variant       Variant? @relation(fields: [variantId], references: [id])
  staffId       String
  staff         Staff    @relation(fields: [staffId], references: [id])
  createdAt     DateTime @default(now())

  attachments Attachment[]

  @@index([imei])
}

// ─────────────────────────────── Documents & attachments (master brief §7) ───────────────────────────────

/// Uploaded document or file. Never served from a public URL: /api/files/[id] checks permissions first.
/// CNIC/ID images are `sensitive` and visible to signed-in staff only.
/// Files are kept in the database (`data`) so uploads work without object storage; with
/// STORAGE_BUCKET set they go to a private bucket (`storageKey`).
model Attachment {
  id                String             @id @default(cuid())
  kind              String // CNIC_FRONT | CNIC_BACK | OTHER | PHOTO | CHAT_FILE | VOICE_NOTE
  fileName          String
  mimeType          String
  size              Int
  sensitive         Boolean            @default(false)
  data              Bytes?
  storageKey        String?
  repairId          String?
  repair            RepairRequest?     @relation(fields: [repairId], references: [id])
  contactMessageId  String?
  contactMessage    ContactMessage?    @relation(fields: [contactMessageId], references: [id])
  installmentSaleId String?
  installmentSale   InstallmentSale?   @relation(fields: [installmentSaleId], references: [id])
  usedPurchaseId    String?
  usedPurchase      UsedPhonePurchase? @relation(fields: [usedPurchaseId], references: [id])
  chatMessageId     String?
  chatMessage       ChatMessage?       @relation(fields: [chatMessageId], references: [id])
  uploadedById      String? // staff uploader (null = uploaded by a customer)
  uploadedBy        Staff?             @relation(fields: [uploadedById], references: [id])
  createdAt         DateTime           @default(now())

  @@index([repairId])
  @@index([installmentSaleId])
  @@index([usedPurchaseId])
  @@index([chatMessageId])
}

// ─────────────────────────────── Broadcasts (master brief §9) ───────────────────────────────

/// Announcement shown in the dark bar at the top of the homepage while published and within its dates.
model Broadcast {
  id          String    @id @default(cuid())
  message     String
  ctaLabel    String?
  ctaHref     String?
  active      Boolean   @default(false) // published
  startsAt    DateTime?
  endsAt      DateTime?
  createdById String?
  createdBy   Staff?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Public media (product photos, 3D source photos, GLB models) kept in the database when no object
/// storage is configured and the server disk is read-only (e.g. the Vercel demo). Served by /api/media/[id].
model MediaFile {
  id        String   @id @default(cuid())
  folder    String
  fileName  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}
